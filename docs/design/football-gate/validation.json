{
  "note": "Football squad gate (docs/design/football-squad-gate.md). Provisional gate (verdict, verdicts): build checks from the shipped data, Spearman of XI strength against World Football Elo at the season's ratingsDate on the gate set, and the EA−FM linking mean from the built-in's audit. Full ship gate (shipVerdict, shipVerdicts): the provisional gate plus the linking check on Reep-linked pairs, the forecast gate on martj42 results in (R_Y, R_next] against Elo frozen at R_Y, the engine-scale gate from engine-scale.json (the built-in) and the audit listing incomplete XIs. Every season ships by choice, so the verdicts are a report. Elo values stay offline; only aggregates, ranks and model scores are recorded. Regenerate with npm run validate:football.",
  "gate": {
    "spearmanMin": 0.9,
    "linkingMaxAbsMean": 1,
    "nations": "The nations that field a side in the season (footballSets.js fieldedNations): a nation with no squad of its own plays no part.",
    "gateSet": "Every fielded nation except nations whose nationStatus is suspended or non-member; OFC stays in and is also reported alone.",
    "truth": "World Football Elo at ratingsDate (after matches dated on or before it), from a snapshot taken on ratingsDate or later",
    "eloDates": "Replay of {Y}_results.tsv over {Y-1}.tsv when the results file has a match dated on or after ratingsDate or a trusted fetch date on or after it, checked against {Y}.tsv from the same snapshot; otherwise World.tsv with a trusted fetch date 0 to 7 days after ratingsDate. A date is trusted when dateFrom is fetch or ends \"vouched by --trust-seed-dates\". Elo frozen at R_Y (the forecast baseline) takes the same replay, but World.tsv only when fetched 0 days after R_Y, on R_Y itself: a later World.tsv has seen results of the matches the forecast scores (leakage), so the forecast is incomplete instead.",
    "verdicts": "fail if any check fails; pass if build, cross-sectional and linking all pass (not applicable counts for neither); otherwise incomplete",
    "bootstrap": {
      "resamples": 2000,
      "seed": 20250919
    },
    "ship": {
      "checks": [
        "provisional gate",
        "linking on Reep-linked pairs: |audit linking.reep.meanEaMinusFm| ≤ 1",
        "forecast gate",
        "engine-scale gate (docs/design/football-gate/engine-scale.json, the built-in at its content hash)",
        "incomplete XIs listed in the audit"
      ],
      "forecast": {
        "window": "(R_Y, R_next]: martj42 full internationals after the season's informationDate, up to the next newer season's; the newest season's window is open and not scored",
        "matches": "Both teams field a side in the season (scripts/lib/results-names.mjs maps the names); matches with a suspended or non-member nation are scored apart; friendlies stay in the gate and are also reported apart",
        "model": "Ordered logit z = β·(Z_home − Z_away) + h·[not neutral], P(home) = σ(z − c), P(away) = σ(−z − c), draw the remainder; Z standardised within the season over every fielded nation; roster T_n is the unrounded best-4-4-2 mean, the baseline Elo frozen at R_Y",
        "matchWindows": "A match window is a FIFA window or a tournament: each finals tournament (every competition but friendlies, qualifiers and Nations Leagues) is one window, named by tournament and the year of its first match (same-name matches over 60 days apart are separate tournaments); friendlies, qualifiers and Nations Leagues group into date windows split at gaps over 10 days",
        "fitting": "k-fold cross-validation grouped by match window, k = min(5, windows): each window whole in one fold, largest first to the fold with the fewest matches, so unequal windows still give balanced folds.",
        "errors": "Paired per-match log-loss difference clustered by match window and, separately, by team pair; the larger SE is used. Each SE is a block bootstrap, 2000 resamples (seed 20261006), or a delete-one-cluster jackknife with fewer than 8 clusters",
        "gate": "roster log loss ≤ Elo-at-R_Y log loss + 2·SE, or + t(G − 1)·SE (two-sided 95% Student t, G the fewer of windows and team pairs) when G < 8; at least 100 matches in 2 or more windows; roster β > 0",
        "coverage": "The window is covered when the pinned results.csv commit is dated after R_next or a match is dated on or after R_next; otherwise forecast.partial and shipPartial are true: the verdict stands on the covered part and is re-scored when a later results.csv is pinned"
      },
      "verdicts": "shipVerdict: fail if any check fails; not scored while the forecast window is open; pass if all that apply pass (not applicable counts for neither); otherwise incomplete"
    }
  },
