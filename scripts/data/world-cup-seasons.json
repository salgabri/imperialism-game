  "elo": {
    "formula": "R' = R + K × G × (W − We), We = 1 / (1 + 10^(−dr / 400)), dr = R_home − R_away + home (none at a neutral venue); W is 1, ½ or 0, a match level after extra time a draw",
    "home": 100,
    "start": {
      "early": 1500,
      "late": 1300,
      "lateAfter": 1930,
      "rule": "A team starts at 1500, or at 1300 when its first match in the results is in a year after 1930."
    },
    "k": {
      "worldCup": [
        "FIFA World Cup"
      ],
      "worldCupK": 60,
      "continental": [
        "UEFA Euro",
        "Copa América",
        "African Cup of Nations",
        "AFC Asian Cup",
        "Gold Cup",
        "CONCACAF Championship",
        "Oceania Nations Cup",
        "Confederations Cup",
        "CONMEBOL–UEFA Cup of Champions"
      ],
      "continentalK": 50,
      "qualifierSuffix": " qualification",
      "qualifier": [
        "UEFA Nations League",
        "CONCACAF Nations League"
      ],
      "qualifierK": 40,
      "friendly": [
        "Friendly"
      ],
      "friendlyK": 20,
      "otherK": 30
    },
    "goals": "G is 1 for a margin of 0 or 1, 1.5 for 2, 1.75 for 3 and 1.75 + (N − 3) / 8 for N of 4 or more",
    "date": "The ratings the day after the final: every match up to and including the final's day",
    "activeYears": 4
  },
  "strength": {
    "best": 87,
    "perHundredElo": 3.2,
    "rule": "T = best − perHundredElo × (E_best − E) / 100: E is the nation's Elo, E_best the best Elo among the teams that played in the four years before.",
    "calibration": "best is the strongest built-in nation's strength (EA FC 27 + FM 26, 2026/27). 3.2 points per 100 Elo gives the game's football model (rate 1.28·e^(1.5·tanh(0.075Δ / 1.5)), Poisson goals) Elo's expected score within 0.0015 for gaps of 50 to 300 Elo, and the 173 built-in strengths regress on their 2026 Elo from the same results with a slope of 3.20 (r 0.895)."
  },
