 "method": {
  "sources": [
   "https://www.tennisabstract.com/blog/2019/12/03/an-introduction-to-tennis-elo/ (expected score; starts in the low 1200s since challengers and qualifying were added, depending on the level)",
   "https://www.tennisabstract.com/blog/2018/05/15/handling-injuries-and-absences/ (layoff penalty, K after a layoff, second layoffs, the 1900 study population, the offseason not counted)",
   "https://www.tennisabstract.com/blog/2019/01/08/identifying-underrated-players-with-minor-league-elo/ (challengers and tour-level qualifying counted)",
   "https://www.tennisabstract.com/blog/2021/03/16/repurposing-elo-for-streaks-seasons/ (yElo, one of the fit targets)",
   "K = 250 / (matches + 5)^0.4 is FiveThirtyEight's formula, which Sackmann said he adapted (sleepomeno/tennis_atp examples/elo.R); his own worked example and the February 2016 report fit an offset of 6"
  ],
  "k": {
   "numerator": 250,
   "offset": 6,
   "exponent": 0.4
  },
  "start": {
   "tour": 1330,
   "challenger": 1275,
   "qualifying": 1275,
   "fit": "Not published: the tour-level start fitted on Tennis Abstract's own current-method numbers for 1973-2000, the career peaks of the 17 women of its Tennis 128 profiles whose peaks fall then; the start of an ITF event, a WTA 125 or a qualifying round is the men's, which keeps the 2021-2025 lists within ten points of Tennis Abstract's. Before 1994 the files name no ITF event's prize, so a newcomer's first counted match is at tour level, and the men's 1450 there lifts the 1970s and 1980s by about 100 points."
  },
  "layoff": {
   "weeks": 8,
   "min": 100,
   "max": 150,
   "maxWeeks": 52,
   "kBoost": 1.5,
   "kMatches": 20,
   "repeatDays": 730,
   "threshold": 1900,
   "offseason": [
    1115,
    115
   ],
   "note": "A layoff of eight weeks or more between counted matches, 15 November to 15 January not counted, costs 100 points rising linearly to 150 at a year; K is then 1.5 times as large, back to normal over 20 matches; a second layoff within two years of the last comeback is charged the difference between the penalty for both together and for the first. Charged on return; a list shows a player in the middle of one with the penalty he would be charged on the list's date. Only for players rated 1900 or more, as in the study that set it (applied to everyone it lowers the whole list by 100 to 200 points against every published number)."
  },
  "files": "all",
  "challengerQualifying": false,
  "counted": "Tour-level main draws with the Fed Cup and Billie Jean King Cup (wta_matches_<year>.csv: not its exhibitions, junior events or ITF circuits under $50K), tour-level qualifying, and the main draws of the WTA 125s (level C from 2012) and of ITF events of $50K or more (wta_matches_qual_itf_<year>.csv), as Tennis Abstract's report says (\"tour-level, tour-level qualifying ... or ITF $50K+\"): not the qualifying of a 125 or an ITF event, nor any ITF event before 1994, whose prize the files do not name; nor a walkover, retirement, default, abandoned or unfinished match, nor one without a score or against a placeholder opponent.",
  "order": "By the files' season, then the event's date, the event, the round (qualifying first) and the match number: a season ends after its last event and before the next season's first, even one that starts in late December.",
  "activity": 10,
  "activityNote": "A season lists the women who played at least 10 counted matches in it, as Tennis Abstract's report lists those with 10 in the last 52 weeks. The published seasons keep the women of Tennis Abstract's list who pass the same test in the match files.",
  "asOf": "A list is dated 31 December, or the start of the season's last event when that is later.",
