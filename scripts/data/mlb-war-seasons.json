  "seasons": { "from": 1960, "to": 2017 },
  "method": {
    "note": "Sums run over a player's stints of the season. A stint's WAR is the file's WAR per 162 team games times its club's scheduled games over 162 (the season's own WAR). A player is a pitcher when his innings times `pitcher.inningsPerPa` exceed his plate appearances, or when he pitched in at least `pitcher.gamesShare` as many games as he batted in with fewer than `pitcher.maxPa` plate appearances; a pitcher starts (SP) when his starts are at least `starterShare` of his games over the season and the one before, else he relieves (RP). A hitter's position is the fielding position he played most games at in the season (the most over the three seasons breaking ties, in the order C, 1B, 2B, 3B, SS, LF, CF, RF), else the one he played most over the three, else the designated hitter; he can also field each other position he played at least `secondaryGames` games at over the three seasons. His club is that of his last stint. Scores by role: per × (Σ weight·WAR + prior·rate) / (Σ weight·use + prior), use being plate appearances (H) or innings (SP, RP), over the season and the two before it (weights latest first), plus leverage × the season's average leverage index for a reliever. Ratings: rank for rank within the role onto `scripts/data/mlb-war-reference.json`.",
    "seasonsBack": 3,
    "pitcher": {
      "inningsPerPa": 4.3,
      "gamesShare": 0.8,
      "maxPa": 100
    },
    "starterShare": 0.4,
    "secondaryGames": 3,
    "roles": {
      "H": {
        "weights": [5, 3, 2],
        "prior": 600,
        "rate": -0.015,
        "per": 600
      },
      "SP": {
        "weights": [5, 3, 2],
        "prior": 150,
        "rate": -0.03,
        "per": 180
      },
      "RP": {
        "weights": [1, 1, 1],
        "prior": 30,
        "rate": -0.05,
        "per": 65,
        "leverage": 0.8
      }
    },
    "calibration": {
      "years": [2018, 2019, 2020, 2021, 2022, 2023, 2024],
      "clubs": 30,
      "twoWay": {
        "innings": 20,
        "pa": 100
      }
    }
  },
  "seasonSource": {
    "note": "The source block of every computed season's file (public/baseball/mlb-war-<year>.json), with `url` the WAR file's at its pinned commit.",
    "method": "Each player's WAR (JEFFBAGWELL: the average of Baseball-Reference's and FanGraphs' WAR) per playing time over the season and the two before it, weighted 5, 3 and 2 (relievers 1, 1 and 1) and regressed toward a level below replacement: hitters 600 × (Σ weight·WAR − 9) / (Σ weight·PA + 600); starters 180 × (Σ weight·WAR − 4.5) / (Σ weight·IP + 150); relievers 65 × (Σ WAR − 1.5) / (Σ IP + 30) + 0.8 × the season's average leverage index. Roles and positions from his games, starts and innings, his club his last. docs/design/baseball.md, \"Seasons before 2018: computed from WAR\".",
    "conversion": "Rank for rank within each role (hitters, starters, relievers) onto MLB The Show 18 to 24's overalls at the same depth per club: the k-th best score of a season of T clubs takes the overall at index (k − 0.5) / T × 210 − 0.5 of that role's 9,674-card reference, strongest first (scripts/data/mlb-war-reference.json), interpolated and rounded; equal scores share their mean rank.",
    "licence": "WAR: JEFFBAGWELL (Neil Paine), MIT. Names, birthplaces, clubs and ballparks: the Lahman Baseball Database 2025 (SABR), CC BY-SA 3.0. See public/baseball/ATTRIBUTION.txt.",
    "retrieved": "2026-11-09"
  },
