    "retrieved": "2026-11-09",
    "terms": "CC0: Public Domain (Kaggle's metadata), Sumitro Datta's copy of Basketball-Reference's regular seasons, dataset version 57 (updated 1 November 2026), downloaded anonymously from Kaggle's API; nothing was fetched from basketball-reference.com. PER, WS/48 and defensive win shares are Basketball-Reference's own calculations; Sports-Reference's data-use terms forbid scraping that harms its sites, building a competing database and AI training with its data, and say facts are not copyrightable. Advanced.csv gives each player season's position, games, minutes, PER, WS/48 and DWS; Player Totals.csv points, rebounds and assists (the same file `check` pins); All-Star Selections.csv and End of Season Teams.csv the All-Star and All-NBA picks; Player Career Info.csv the career position (G, F-C...), for a player a season lists no position for and for a second position his other seasons do not give; Team Summaries.csv each team's name (checked against `teams`), SRS (the audit's comparison only) and the league's pace and offensive rating, and Team Stats Per Game.csv its points a game (both checked against src/data/nbaLeagueAverages.js).",
    "seasons": [1961, 1962, 1963, 1964, 1965, 1966, 1967, 1968, 1969, 1970, 1971, 1972, 1973, 1974, 1975, 1976, 1977, 1978, 1979, 1980, 1981, 1982, 1983, 1985, 1986, 1987, 1988, 1989, 1990, 1991, 1993, 1994, 1995, 1996, 1997, 1998],
    "score": {
      "intercept": -1.91373,
      "coefficients": { "per": 0.0541565, "ws48": 0.342456, "mpg": 0.00592352, "mpg2": 0.00000972204, "ppg": 0.0683889, "rpg": 0.0254284, "apg": 0.0709854, "allStar": 0.264524, "allNba": 0.0486592, "dws": 0.111944 },
      "shrink": { "minutes": 400, "per": 11, "ws48": 0.05 },
      "allNba": { "1st": 3, "2nd": 2, "3rd": 1 },
      "training": { "editions": [2000, 2026], "lag": 1 },
      "note": "score = intercept + the sum of each coefficient times its input: PER and WS/48 shrunk toward a bench player's 11 and 0.05 by 400 minutes ((value × minutes + prior × 400) / (minutes + 400)), minutes a game and its square, points, rebounds and assists a game, All-Star (1 if picked), All-NBA (3, 2 or 1 for the 1st, 2nd or 3rd team) and defensive win shares, from the player's whole season. The coefficients are the least-squares fit of NBA 2K's overall, as a z-score within each edition, on those inputs from each player's season before (2K rates a season's players from the season before), over 2K Archive's NBA 2K (1999/00) to NBA 2K26 (2025/26), its NBA 2K12 its own, players matched by name (and club where two share one): 9,970 pairs. Every coefficient is positive. The build fits them again and stops if any differs at six significant figures; the ratings use these, so a later copy of 2K Archive's page cannot move them."
    },
    "roster": 13,
    "spread": { "edition": 2027, "perClub": 13,
      "counts": { "69": 1, "70": 1, "71": 15, "72": 17, "73": 33, "74": 44, "75": 33, "76": 37, "77": 14, "78": 25, "79": 47, "80": 20, "81": 13, "82": 13, "83": 8,
