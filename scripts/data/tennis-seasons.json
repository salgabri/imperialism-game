  "method": {
    "sources": [
      "https://www.tennisabstract.com/blog/2019/12/03/an-introduction-to-tennis-elo/ (expected score; starts in the low 1200s since challengers and qualifying were added, depending on the level)",
      "https://www.tennisabstract.com/blog/2018/05/15/handling-injuries-and-absences/ (layoff penalty, K after a layoff, second layoffs, the 1900 study population, the offseason not counted)",
      "https://www.tennisabstract.com/blog/2019/01/08/identifying-underrated-players-with-minor-league-elo/ (challengers and tour-level qualifying counted)",
      "https://www.tennisabstract.com/blog/2021/03/16/repurposing-elo-for-streaks-seasons/ (yElo, one of the fit targets)",
      "K = 250 / (matches + 5)^0.4 is FiveThirtyEight's formula, which Sackmann said he adapted (sleepomeno/tennis_atp examples/elo.R); his own worked example and the February 2016 report fit an offset of 6"
    ],
    "k": {
      "numerator": 250,
      "offset": 6,
      "exponent": 0.4
    },
    "start": {
      "tour": 1450,
      "challenger": 1275,
      "qualifying": 1275,
      "fit": "Not published: fitted on Tennis Abstract's own current-method numbers for 1974-2000, the 23 career peaks of its Tennis 128 profiles and the 18 yElo seasons of its season tables (counted by the match files' seasons): mean difference -2.0 Elo, root mean square 15.1 (1970s -1.2, 1980s -1.6, 1990s -4.7)."
    },
    "layoff": {
      "weeks": 8,
      "min": 100,
      "max": 150,
      "maxWeeks": 52,
      "kBoost": 1.5,
      "kMatches": 20,
      "repeatDays": 730,
      "threshold": 1900,
      "offseason": [
        1115,
        115
      ],
      "note": "A layoff of eight weeks or more between counted matches, 15 November to 15 January not counted, costs 100 points rising linearly to 150 at a year; K is then 1.5 times as large, back to normal over 20 matches; a second layoff within two years of the last comeback is charged the difference between the penalty for both together and for the first. Charged on return; a list shows a player in the middle of one with the penalty he would be charged on the list's date. Only for players rated 1900 or more, as in the study that set it (applied to everyone it lowers the whole list by 100 to 200 points against every published number)."
    },
    "files": "all",
    "challengerQualifying": false,
    "counted": "Tour-level main draws with the Davis Cup (atp_matches_<year>.csv), tour-level qualifying and challengers' main draws (atp_matches_qual_chall_<year>.csv), as Tennis Abstract's report says (\"tour-level, tour-level qualifying, men's challenger\"): not a challenger's qualifying (the files hold whole qualifying draws in 2018 and from 2022; counting them lists some 180 men a season Tennis Abstract does not and lifts the modern lists by 20 to 40 points), nor a walkover, retirement, default, abandoned or unfinished match, nor one without a score or against a placeholder opponent (\"U Unknown\").",
    "order": "By the files' season, then the event's date, the event, the round (qualifying first) and the match number: a season ends after its last event (the Masters played in January 1978-1986 belongs to the year before) and before the next season's first, even one that starts on 29 December.",
    "activity": 10,
    "activityNote": "A season lists the men who played at least 10 counted matches in it, as Tennis Abstract's report has listed those with 10 in the last 52 weeks since 2020. The published seasons keep the men of Tennis Abstract's list who pass the same test in the match files.",
    "asOf": "A list is dated 31 December, or the start of the season's last event when that is later.",
