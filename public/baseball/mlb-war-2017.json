ne more, so nobody passes a teammate.","licence":"WAR: JEFFBAGWELL (Neil Paine), MIT. Names, birthplaces, clubs and ballparks: the Baseball Databank (Chadwick Baseball Bureau), CC BY-SA 3.0; its home games from Retrosheet. See public/baseball/ATTRIBUTION.txt.","url":"https://raw.githubusercontent.com/Neil-Paine-1/MLB-WAR-data-historical/1c8c3084d62112efdaa7054125af3cd01003e38d/jeffbagwell_war_historical_2025.csv","retrieved":"2026-11-10","rawScale":"WAR"},"map":"mlb2017","nations":{"124":[60,10,[["Russell Martin","C/2B/3B",79],["Joey Votto","1B",89],["Michael Saunders","RF/LF",70],["Jim Adduci","RF",66],["James Paxton","SP",82],["Nick Pivetta","SP",66],["Andrew Albers","SP",61],["John Axford","RP",70],["Rob Zastryzny","RP",62],["Jesen Therrien","RP",56]]],"156":[46,1,[["Austin Brice","RP",61]]],"158":[51,5,[["Tzu-Wei Lin","2B/3B/SS",65],["Wei-Yin Chen","SP",73],["Jen-Ho Tseng","SP",55],["Chih-Wei Hu","RP",58],["Wei-Chung Wang","RP",57]]],"170":[53,6,[["Jorge Alfaro","C",67],["Gio Urshela","3B/2B/SS",68],["Jose Quintana","SP",83],["Julio Teheran","SP",79],["Ernesto Frieri","RP",63],["Dayan Diaz","RP",54]]],"192":[77,19,[["Yasmani Grandal","C/1B",84],["Jose Abreu","1B",84],["Yuli Gurriel","1B/3B",74],["Yonder Alonso","1B/3B",73],["Kendrys Morales","1B/RF",72],["Yoan Moncada","2B/3B",74],["Yunel Escobar","3B",76],["Adeiny Hechavarria","SS",75],["Aledmys Diaz","SS/3B/LF",74],["Jose Iglesias","SS",74],["Yoenis Cespedes","LF/CF",81],["Leonys Martin","CF/LF/RF",72],["Yasiel Puig","RF/LF/CF",78],["Ariel Miranda","SP",66],["Onelki Garcia","SP",49],["Aroldis Chapman","RP",86],["Raisel Iglesias","RP",81],["Odrisamer Despaigne","RP",66],["Roenis Elias","RP",64]]],"214":[83,26,[["Gary Sanchez","C",84],["Welington Castillo","C",77],["Edwin Encarnacion","1B",82],["Carlos Santana","1B/RF",79],["Robinson Cano","2B",81],["Jose Ramirez","3B/2B/SS/LF",89],["Adrian Beltre","3B",87],["Miguel Sano","3B/1B/RF",79],["Jean Segura","SS/2B",80],["Marcell Ozuna","LF/CF/RF",83],["Starling Marte"